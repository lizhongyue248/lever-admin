# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Better Auth
# Secret used by Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:4000"

# Better Auth GitHub OAuth
BETTER_AUTH_GITHUB_CLIENT_ID=""
BETTER_AUTH_GITHUB_CLIENT_SECRET=""

# Better Auth Google OAuth (optional)
BETTER_AUTH_GOOGLE_CLIENT_ID=""
BETTER_AUTH_GOOGLE_CLIENT_SECRET=""

# Google reCAPTCHA v3
NEXT_PUBLIC_GOOGLE_RECAPTCHA_SITE_KEY=""
NEXT_PUBLIC_GOOGLE_RECAPTCHA_SCRIPT_HOST="www.google.com"
GOOGLE_RECAPTCHA_SECRET_KEY=""
GOOGLE_RECAPTCHA_MIN_SCORE="0.5"

# Drizzle
DATABASE_URL="postgresql://postgres:password@localhost:5432/lever-admin"

# Transactional email
# console logs safe email metadata locally; resend and smtp send real email.
EMAIL_PROVIDER="console"
EMAIL_FROM="Lever Admin <no-reply@example.com>"

# Required when EMAIL_PROVIDER="resend"
RESEND_API_KEY=""

# Required when EMAIL_PROVIDER="smtp"
# Google/Gmail SMTP example:
# EMAIL_PROVIDER="smtp"
# EMAIL_FROM="Lever Admin <your-email@gmail.com>"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASSWORD="your-google-app-password"
# SMTP_SECURE="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"
